{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "galpao",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "galpao-servidor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:servidor", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "galpao-servidor-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:servidor:celular", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "url": "https://localhost:5173"
    }
  ]
}
