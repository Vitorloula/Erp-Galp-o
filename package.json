{
  "name": "galpao-estoque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --mode celular",
    "dev:servidor": "vite --mode servidor",
    "dev:servidor:celular": "vite --mode servidor-celular",
    "build": "tsc -p . && vite build",
    "lint": "tsc -p . --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sql": "node scripts/testar-sql.mjs",
    "test:e2e": "tsc -p e2e && playwright test",
    "test:e2e:relatorio": "playwright show-report",
    "test:tudo": "npm run build && npm test && npm run test:sql && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "ws": "^8.22.0"
  }
}
