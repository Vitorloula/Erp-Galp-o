# Copie este arquivo para ".env" e preencha.
# Deixando as duas primeiras vazias, o sistema abre em MODO DEMONSTRAÇÃO
# (dados de exemplo salvos apenas no navegador).

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → chave "anon public" (ou "publishable")
# Esta chave PODE ficar no site: quem protege os dados são as regras (RLS) do banco.
VITE_SUPABASE_ANON_KEY=

# Nome exibido no topo do sistema e nos relatórios Excel/PDF
VITE_NOME_EMPRESA=Controle de Galpão
