# Copie este arquivo para ".env" e preencha para usar o Supabase na nuvem.
# Sem .env, "npm run dev" usa o servidor local de teste (banco em servidor-local/banco/).

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → chave "anon public" (ou "publishable")
# Esta chave PODE ficar no site: quem protege os dados são as regras (RLS) do banco.
VITE_SUPABASE_ANON_KEY=

# Opcional: nome do sistema na tela de login (o nome de cada empresa vem do cadastro)
VITE_NOME_SISTEMA=Controle de Estoque

# ─────────────────────────────────────────────────────────────────────────────
# NFC-e (documento fiscal) e Cobrança (Asaas) — integrações futuras
# ─────────────────────────────────────────────────────────────────────────────
# Estas chaves NÃO devem ficar no cliente em produção: o ideal é guardá-las
# como segredos do Supabase e chamar uma Edge Function. Os valores VITE_* abaixo
# são apenas placeholders usados pelos stubs em src/lib/nfce.ts e cobranca.ts,
# para deixar a integração "no ponto de só colocar as keys".
#
# NFC-e: quando configuradas, src/lib/nfce.ts passa a emitir (trocar o stub pela API real).
# VITE_NFCE_URL=
# VITE_NFCE_TOKEN=
# VITE_NFCE_CSC=
# VITE_NFCE_CSC_ID=
# VITE_NFCE_SERIE=1
#
# Cobrança: quando configurada, src/lib/cobranca.ts passa a cobrar (trocar o stub pela API real).
# VITE_ASAAS_API_KEY=
